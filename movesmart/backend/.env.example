# Django Production Environment Configuration
DJANGO_SECRET_KEY=production-secret-key-change-in-deploy
DJANGO_DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com,.railway.app

# Database Configuration (PyMongo)
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=movesmart_db

# Authentication (JWT)
JWT_SECRET=jwt-signing-secret-change-in-deploy
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60

# External API Integrations (Server-side ONLY)
GEMINI_API_KEY=your-production-gemini-api-key
MAPS_API_KEY=your-production-google-maps-api-key

# CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://movesmart.vercel.app
