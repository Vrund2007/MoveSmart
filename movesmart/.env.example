# ==========================================
# MoveSmart Environment Variables Configuration
# ==========================================
# Copy this file to .env and populate with appropriate values.
# DO NOT COMMIT REAL SECRETS TO GIT.

# Django Settings
DJANGO_SECRET_KEY=your-django-secret-key-here
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# MongoDB Configuration (PyMongo)
MONGO_URI=mongodb://localhost:27017
DATABASE_NAME=movesmart_db

# Authentication / JWT Settings
JWT_SECRET=your-jwt-secret-key-here
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# External API Integrations (Server-side only)
GEMINI_API_KEY=your-gemini-api-key-here
MAPS_API_KEY=your-google-maps-api-key-here

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
