# MoveSmart — Environment Variables
# Copy this file to .env and fill in your values. NEVER commit .env to git.
# See Rules.md §5 for secrets policy.

# ─── Django ───────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ─── MongoDB (PyMongo) ────────────────────────────────────────────────────────
MONGO_URI=

# ─── JWT (djangorestframework-simplejwt) ──────────────────────────────────────
JWT_SECRET=
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60

# ─── External APIs ────────────────────────────────────────────────────────────
# Gemini API — server-side only, never exposed to the frontend (Rules.md §5)
GEMINI_API_KEY=
# Google Maps Distance Matrix API (or equivalent) — server-side only
MAPS_API_KEY=

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000
